# Use openai, ollama, or auto. For official evaluation, configure an actual LLM provider.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=30
# Official contract requires false. Set true only for extended/custom multi-clause packs.
ALLOW_MULTIPLE_DIRECTIVES_PER_NOTE=false
LOG_LEVEL=INFO
ENABLE_DOCS=true
